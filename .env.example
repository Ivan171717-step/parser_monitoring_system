# Target and mode
TARGET_SITE=https://example.com
MODE=all

# Safe scraping
REQUEST_DELAY_MIN=3
REQUEST_DELAY_MAX=7
MAX_PAGES=10
MAX_ITEMS=200
MAX_RETRIES=3
STOP_ON_CAPTCHA=true
REQUEST_TIMEOUT=20
USE_SELENIUM=false
DEFAULT_REGION=US

# Optional path fragments
PRODUCTS_PATH=/products
LEADS_PATH=/stores
CUSTOMERS_PATH=/directory

# CSS selectors for products
PRODUCT_CARD_SELECTOR=.product-item
PRODUCT_NAME_SELECTOR=.name
PRODUCT_PRICE_SELECTOR=.price
PRODUCT_AVAILABILITY_SELECTOR=.stock
PRODUCT_LINK_SELECTOR=a
NEXT_PAGE_SELECTOR=a.next

# CSS selectors for leads/customers
CONTACT_CARD_SELECTOR=.company,.store,.seller,.listing
COMPANY_NAME_SELECTOR=.company-name,.store-name,.title,h2,h3
CONTACT_WEBSITE_SELECTOR=a.website,a[href^='http']

# Telegram secrets. Do not commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

# Scheduler
RUN_EVERY_HOURS=6
TIMEZONE=Europe/Zaporozhye
